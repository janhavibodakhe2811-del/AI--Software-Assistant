# Copy this file to .env and fill in your values
# Get Gemini API key free at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Git executable path (needed on Windows, optional on Linux/macOS)
GIT_PYTHON_GIT_EXECUTABLE=C:/Program Files/Git/cmd/git.exe

# Where cloned repos will be stored temporarily
TEMP_REPOS_DIR=./temp_repos

# Maximum repo size to analyze (in MB)
MAX_REPO_SIZE_MB=100

# Max files to analyze per repo (keeps costs low)
MAX_FILES=150
